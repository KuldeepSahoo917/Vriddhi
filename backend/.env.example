PORT=4000
# When deployed, set this to your real frontend URL (e.g. a Vercel
# domain). The refresh-token cookie's cross-site behavior depends on
# NODE_ENV being set to "production" AND this being correct — see the
# NODE_ENV note near the bottom of this file.
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vriddhi

# Generate strong random secrets, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# From Google Cloud Console > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# From aistudio.google.com > Get API key (free tier, no billing required)
GEMINI_API_KEY=your-gemini-api-key-here
# Optional — defaults to gemini-3.1-flash-lite if not set.
# Google's Gemini 2.x models (2.0-flash, 1.5-flash, 2.5-flash-lite) are
# either shut down or restricted to pre-existing accounts only — new
# API keys need the Gemini 3.x generation. Check aistudio.google.com
# for the current free-tier lineup if this breaks again; Google
# deprecates/restricts models frequently.
GEMINI_MODEL=gemini-3.1-flash-lite

# From resend.com > API Keys (free tier, no billing required).
# If left unset, password reset links print to the backend terminal
# instead of emailing — fine for local testing.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Vriddhi <onboarding@resend.dev>

NODE_ENV=development
# Set to "production" when deployed — this flips the refresh-token
# cookie to sameSite:'none' + secure:true, which is required once the
# frontend and backend are on different domains (the normal case for
# a deployed app). Leaving this as "development" in production will
# make login appear to work but sessions won't actually persist,
# since the browser will silently refuse to send the cookie cross-site.
